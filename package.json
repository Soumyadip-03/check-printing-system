{
  "name": "check-printer",
  "version": "1.0.4",
  "description": "Professional desktop application for printing bank checks with customizable JSON templates, featuring precise field positioning, Indian number-to-words conversion, and comprehensive template management.",
  "author": "Soumyadip Khan Sarkar",
  "main": "main.js",
  "homepage": "./",
  "private": true,
  "dependencies": {
    "electron-log": "^5.0.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\" --kill-others",
    "electron-build": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "electron": "^37.3.1",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.32",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.0",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.checkprinter.app",
    "productName": "Check Printer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/LOGO.png",
      "publisherName": "Soumyadip Khan Sarkar",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Soumyadip-03",
      "repo": "check-printing-system"
    }
  }
}
